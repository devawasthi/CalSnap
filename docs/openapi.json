{
  "openapi": "3.1.0",
  "info": {
    "title": "CalSnap API",
    "version": "1.0.0",
    "description": "Same-origin React PWA API. Google authorization-code OIDC login begins at /auth/google and returns to /auth/callback. JWTs use HttpOnly SameSite=Lax Secure cookies in production. GET /session supplies the CSRF header value. Local demo login POST /auth/demo exists only with APP_ENV=local and requires the configured Origin."
  },
  "servers": [
    {
      "url": "http://localhost:5173",
      "description": "Local same-origin frontend proxy"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
