  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "calsnap_session"
      }
    },
    "schemas": {
      "Macros": {
        "type": "object",
        "required": ["calories", "protein", "carbs", "fat"],
        "properties": {
          "calories": {
            "type": "number",
            "minimum": 0,
            "maximum": 50000
          },
          "protein": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "carbs": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "fat": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          }
        }
      },
      "Selection": {
        "type": "object",
        "required": ["foodName", "portionG", "macros"],
        "properties": {
          "foodName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "portionG": {
            "type": "number",
            "maximum": 10000,
            "minimum": 0.01
          },
          "macros": {
            "$ref": "#/components/schemas/Macros"
          }
        }
      },
      "Confirm": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Selection"
            }
          },
          "loggedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GoalInput": {
        "type": "object",
        "required": ["dailyCalories", "dailyProteinG", "effectiveFrom"],
        "properties": {
          "dailyCalories": {
            "type": "number",
            "minimum": 1,
            "maximum": 20000
          },
          "dailyProteinG": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Goal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "daily_calories": {
            "type": "number"
          },
          "daily_protein_g": {
            "type": "number"
          },
          "effective_from": {
            "type": "string",
            "format": "date"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Entry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "scan_id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "food_name": {
            "type": "string"
          },
          "calories": {
            "type": "number"
          },
          "protein_g": {
            "type": "number"
          },
          "carbs_g": {
            "type": "number"
          },
          "fat_g": {
            "type": "number"
          },
          "portion_g": {
            "type": "number"
          },
          "quantity_multiplier": {
            "type": "number"
          },
          "logged_at": {
            "type": "string",
            "format": "date-time"
          },
          "imageUrl": {
            "type": "string",
            "description": "Short-lived signed URL; fetch a fresh summary to renew."
          }
        }
      },
      "Nutrition": {
        "type": "object",
        "properties": {
          "fdcId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "per100g": {
            "$ref": "#/components/schemas/Macros"
          }
        }
      },
      "Candidate": {
        "type": "object",
        "properties": {
          "foodName": {
            "type": "string"
          },
          "portionG": {
            "type": "number"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Nutrition"
            }
          },
          "estimatedMacros": {
            "$ref": "#/components/schemas/Macros",
            "description": "AI-estimated totals for the photographed portion; used when no USDA match is available."
          }
        }
      },
      "Scan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "pending"
          },
          "imageUrl": {
            "type": "string"
          },
          "manualEntry": {
            "type": "boolean"
          },
          "demo": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string"
          },
          "consumed": {
            "$ref": "#/components/schemas/Macros"
          },
          "goal": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Goal"
              },
              {
                "type": "null"
              }
            ]
          },
          "remaining": {
            "type": ["object", "null"],
            "properties": {
              "calories": {
                "type": "number"
              },
              "protein": {
                "type": "number"
              }
            },
            "description": "May be negative when a goal is exceeded; null before the first effective goal."
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          }
        }
      },
      "History": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "page": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "csrf": {
            "type": "string"
          },
          "demo": {
            "type": "boolean"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
